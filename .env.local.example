# Copy to .env.local for local development with hot reload:
#   cp .env.local.example .env.local
#
# Then run: pnpm dev:local

NEXTAUTH_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
NEXT_PUBLIC_API_URL=http://localhost:3000

NEXTAUTH_SECRET=dev-only-change-me-generate-with-openssl-rand-base64-32
AUTH_SECRET=dev-only-change-me-generate-with-openssl-rand-base64-32

MONGO_INITDB_ROOT_USERNAME=gnosis
MONGO_INITDB_ROOT_PASSWORD=gnosisdev
MONGO_DB=gnosis

# Host machine → Docker Mongo (pnpm dev:local)
MONGODB_URI=mongodb://gnosis:gnosisdev@127.0.0.1:27017/gnosis?authSource=admin

# Service default AI provider. Individual users can select a BYO provider in AI settings.
AI_PROVIDER=groq
OLLAMA_BASE_URL=http://127.0.0.1:11434/api
OLLAMA_MODEL=qwen2.5:3b
# Set true only for models that support thinking (deepseek-r1, qwen3, qwq).
OLLAMA_ENABLE_THINKING=false
# Lets self-hosted Gnosis instances use a user's locally reachable Ollama endpoint.
ALLOW_LOCAL_AI_ENDPOINTS=true
# Required to encrypt BYO provider keys and GitHub OAuth tokens at rest.
BYOK_ENCRYPTION_KEY=dev-only-change-me-use-a-random-32-character-minimum-secret
# Optional role-specific model overrides.
# OLLAMA_STRUCTURED_MODEL=qwen2.5:7b
# OLLAMA_CREATIVE_MODEL=qwen2.5:7b
# OLLAMA_FAST_MODEL=deepseek-r1:8b

# Optional: override GitHub REST API version (default: 2026-03-10)
# GITHUB_API_VERSION=2026-03-10

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Generate with: pnpm setup:github
GITHUB_WEBHOOK_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# These exact names are read by the checkout route.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_PRICE_CREDITS_10=
