    "dev": "next dev",
    "dev:local": "bash scripts/dev-local.sh",
    "dev:local:down": "docker compose --env-file .env.local -f docker-compose.dev.yml down",
    "dev:docker": "bash scripts/dev-docker.sh",
    "dev:docker:down": "docker compose --env-file .env.local -f docker-compose.dev.yml --profile docker-dev down",
