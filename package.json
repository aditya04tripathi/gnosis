    "lint": "biome check",
    "format": "biome format --write",
    "docker:build": "docker build -t gnosis .",
    "docker:up": "docker compose up --build -d && echo http://localhost:49154",
    "docker:down": "docker compose down",
    "docker:prod:pull": "docker compose -f docker-compose.prod.yml pull",
    "docker:prod:up": "docker compose -f docker-compose.prod.yml up -d && echo http://localhost:49154",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down"
