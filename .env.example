IMAGE_TAG=latest

NEXTAUTH_URL=https://gnosis.adityatripathi.dev
AUTH_URL=https://gnosis.adityatripathi.dev
AUTH_TRUST_HOST=true

NEXTAUTH_SECRET=your-generated-secret
AUTH_SECRET=your-generated-secret

MONGO_INITDB_ROOT_USERNAME=gnosis
MONGO_INITDB_ROOT_PASSWORD=change-me-strong-password
MONGO_DB=gnosis

GROQ_API_KEY=your-groq-api-key
# Required to encrypt BYO keys at rest. Generate with `openssl rand -base64 48`.
BYOK_ENCRYPTION_KEY=
# Permit only when Ollama is reachable from the Gnosis server.
ALLOW_LOCAL_AI_ENDPOINTS=false

GITHUB_CLIENT_ID=your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...
STRIPE_PRICE_CREDITS_10=price_...

MONGODB_URI=mongodb://gnosis:change-me-strong-password@mongo:27017/gnosis?authSource=admin

NEXT_PUBLIC_API_URL=https://gnosis.adityatripathi.dev
